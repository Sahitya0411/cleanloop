# Local development (no AWS needed): demo logins and the local API.
VITE_AUTH_MODE=local
VITE_API_URL=http://localhost:8787

# After `npm run deploy`, scripts/deploy.sh writes frontend/.env.production.local with:
# VITE_AUTH_MODE=cognito
# VITE_API_URL=https://xxxx.execute-api.ap-south-1.amazonaws.com
# VITE_AWS_REGION=ap-south-1
# VITE_USER_POOL_ID=ap-south-1_XXXX
# VITE_USER_POOL_CLIENT_ID=xxxx
# VITE_MAPS_API_KEY=v1.public.xxxx
# VITE_DEMO_PASSWORD=...           (only if demo logins are enabled)
# VITE_DEMO_EMAILS={"resident":"...","driver":"...","officer":"...","recycler":"..."}
